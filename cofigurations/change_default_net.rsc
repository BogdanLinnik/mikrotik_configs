# =============================================================================
# MikroTik RB4011iGS+5HacQ2HnD  |  RouterOS 7.2.7
# Базове налаштування 2xWAN (DHCP) з failover ПОВЕРХ заводських defaults.
# -----------------------------------------------------------------------------
# Робочий цикл для тестування:
#   1) Скинь на завод (роутер перезавантажиться):
#        /system reset-configuration no-defaults=no skip-backup=no
#   2) Після ребуту підключись до 192.168.88.1 з LAN-порту (ether3..ether10).
#      Логін: admin, пароль стандартний.
#      Налаштуй новий пароль для admin.
#   3) Залий цей файл на роутер:
#        scp change_default_net.rsc admin@192.168.88.1:change_default_net.rsc
#        (або будь-яким іншим зручним способом; можна навіть створити скрипт в Winbox і вставити код вручну)
#   4) У терміналі роутера:
#        /import file-name=change_default_net.rsc verbose=yes
#
# Увага: після виконання роутер буде доступний на 192.168.0.1
#
# ВАЖЛИВО: не підключай до WAN-портів роутери, що роздають адреси з мережі
# 192.168.0.0/24 (наприклад, домашній роутер провайдера з тим самим пулом).
# LAN цього MikroTik теж використовує 192.168.0.0/24, тому виникне конфлікт
# маршрутизації: RouterOS не зможе відрізнити трафік до локальних пристроїв
# від трафіку до шлюзу ISP і маршрут буде непередбачуваним.
# =============================================================================

# ---------- 1. IP-адреса LAN-інтерфейсу ----------
# Замінюємо 192.168.88.1/24 → 192.168.0.1/24 на bridge (LAN)
/ip address
set [find address="192.168.88.1/24"] address=192.168.0.1/24

# ---------- 2. DHCP-пул ----------
/ip pool
set [find name="default-dhcp"] ranges=192.168.0.10-192.168.0.254

# ---------- 3. DHCP-сервер — шлюз і мережа ----------
/ip dhcp-server network
set [find address="192.168.88.0/24"] \
    address=192.168.0.0/24 \
    gateway=192.168.0.1 \
    dns-server=192.168.0.1

# ---------- 4. Перевірка ----------
# /ip address print
# /ip dhcp-server network print
# /ip pool print
